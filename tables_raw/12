$$\begin{align*}
    &\lim_{h\to0} \frac{f(x+h)-f(x)}h \\
    \boldsymbol{={}}& \boldsymbol{\frac{(x^2+2xh+h^2) - x^2}h} \\
    ={}& 2x.
\end{align*}$$
